# ---------------------------------------------------------------------------
# Email Assistant — environment variables. Copy to .env (npm run setup does it
# for you and fills in random secrets). NEVER commit .env.
# ---------------------------------------------------------------------------

# Run everything with fake Gmail/Calendar/Claude (no credentials needed): true/false
MOCK_MODE=false

# Where the backend listens, and its public HTTPS address (used for Google sign-in redirect + passkeys)
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=https://mail.example.com
# Origins allowed to call the API: the PWA origin (same as PUBLIC_URL) and the Android app
APP_ORIGINS=https://mail.example.com,https://localhost,capacitor://localhost

# Database: SQLite file (home server) or Postgres URL (Vercel/Neon)
DATABASE_URL=sqlite:./data/assistant.sqlite
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32 random bytes, base64 — encrypts Google tokens + TOTP secret at rest.  openssl rand -base64 32
ENCRYPTION_KEY=
# Signs app session tokens.  openssl rand -base64 48
SESSION_SECRET=
# Optional fixed first-run setup code (otherwise a random one is printed in the log)
SETUP_CODE=

# Anthropic API key (console.anthropic.com → API keys). Only the backend ever sees it.
ANTHROPIC_API_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI: <PUBLIC_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker: check for new mail every N seconds (also editable in Settings)
POLL_INTERVAL_SECONDS=120
WORKER_ENABLED=true
TIMEZONE=America/Toronto

# Web Push (iPad PWA + desktop). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Android push via Firebase Cloud Messaging (optional): the service-account JSON on one line
FCM_SERVICE_ACCOUNT_JSON=

# Private APK download page (/download): folder with APKs + releases.json, and its password
RELEASES_DIR=./data/releases
DOWNLOAD_PASSWORD=

# Vercel only: secret that Vercel Cron sends to /api/cron/poll
CRON_SECRET=

LOG_LEVEL=info
