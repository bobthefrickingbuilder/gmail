#!/usr/bin/env bash
# Secrets scan: blocks commits containing API keys, OAuth secrets, private keys or .env files.
# Installed by `npm run setup` (git config core.hooksPath scripts/hooks).
set -euo pipefail
FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$FILES" ] && exit 0
fail=0
for f in $FILES; do
  case "$f" in
    .env|.env.*) [ "$f" = ".env.example" ] || { echo "✖ $f must not be committed"; fail=1; } ;;
    *.jks|*.keystore|*keystore.properties|*client_secret*.json|*google-services.json) echo "✖ $f must not be committed"; fail=1 ;;
  esac
  [ -f "$f" ] || continue
  if git show ":$f" | grep -nE 'sk-ant-[A-Za-z0-9_-]{20,}|GOCSPX-[A-Za-z0-9_-]{10,}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|"private_key": *"-----BEGIN|AIza[0-9A-Za-z_-]{35}|ya29\.[0-9A-Za-z_-]{20,}|1//0[0-9A-Za-z_-]{30,}' >/dev/null 2>&1; then
    echo "✖ Possible secret in $f:"; git show ":$f" | grep -nE 'sk-ant-|GOCSPX-|PRIVATE KEY|AIza|ya29\.|1//0' | head -3 | sed 's/\(.\{12\}\).*/\1…/'; fail=1
  fi
done
[ $fail -eq 0 ] || { echo "Commit blocked by secrets scan (scripts/hooks/pre-commit)."; exit 1; }
